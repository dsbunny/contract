{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"strict": true,
		"esModuleInterop": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"moduleResolution": "nodenext",
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "test"]
}
